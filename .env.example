# Скопируйте в .env и заполните нужные поля.
# Файл .env не коммитится. Пустые ключи Bybit допустимы: публичные каналы их не требуют.

# Read-Only ключ Bybit. Торговые права не нужны: система только показывает сигналы.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Demo Trading (режим «Демо трейдинг» на bybit.com → API). Только VPS, не коммитить.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
BYBIT_DEMO_REST_URL=https://api-demo.bybit.com
# 1 — em6r на сайте + market-ордера на Demo (устар.: используйте EM6_BYBIT_ENABLED)
EM6R_LIVE_ENABLED=0
# 1 — вкладка EMA6 Bybit + бот на Demo API
EM6_BYBIT_ENABLED=0
# Адаптивный порог отрыва (корзины 0.5%, пол 4%, пересчёт 3 мин, idle 5 мин)
# EM6_BYBIT_ADAPT_BUCKET_STEP_PCT=0.5
# EM6_BYBIT_WATCH_SAMPLE_MS=10000
# EM6_BYBIT_WATCH_STABLE_MS=20000
# EM6_BYBIT_INITIAL_STOP_COOLDOWN_MS=15000
# EM6_BYBIT_MARGIN_USD=50  → notional = margin × leverage ($500)
# EM6_BYBIT_LEVERAGE=10
# EM6_BYBIT_TRAIL_INITIAL_ROE=50
# EM6_BYBIT_TRAIL_LADDER_STEP_ROE=10
# EM6_BYBIT_TRAIL_LADDER_TIGHTEN_ROE=10
# EM6_BYBIT_TRAIL_MIN_ROE=10
# EM6_BYBIT_TRAIL_ARM_ROE=10
# EM6_BYBIT_STRETCH_FLOOR_PCT=6  — в мониторинг только |цена−EMA60|/EMA ≥ 6%
# PAPER_TEST_ENABLED=0
# 1 — бумажный em6r на «Тесте» параллельно EMA6 Bybit (сравнение)
EM6R_PAPER_PARALLEL=1

# Публичные адреса. Домашний ПК часто хватает api.bybit.com.
# VPS Timeweb (и многие DC): api.bybit.com даёт 403 — официальный KZ без прокси:
# BYBIT_REST_URL=https://api.bybit.kz
# BYBIT_WS_PUBLIC_LINEAR=wss://stream.bybit.kz/v5/public/linear
BYBIT_REST_URL=https://api.bybit.com
BYBIT_WS_PUBLIC_LINEAR=wss://stream.bybit.com/v5/public/linear

# Если Bybit отвечает 403 (блок по стране IP сервера): прокси с выходом не из РФ.
# Пусто — прямое подключение. Пример: socks5://127.0.0.1:1080
BYBIT_PROXY=

# Redis на этой же машине, база 0.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CHANNEL_BUFFER=1024
REDIS_CHANNEL_MARKET=market:data
REDIS_CHANNEL_SIGNALS=signals:updates

# История сигналов. Каталог data/ создаётся при первом запуске записи.
SQLITE_PATH=data/signals.db

# Опционально. Отправка в Telegram на Этапе 1 не включена.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сколько пар держать на одном WebSocket. Стакан 50 уровней шлёт обновления каждые 20 мс.
WS_SYMBOLS_PER_CONNECTION=40
# Как часто перечитывать список контрактов, секунды.
INSTRUMENTS_REFRESH_SEC=300

# Страница сигналов. Слушает только эту машину.
WEB_HOST=127.0.0.1
WEB_PORT=8787
